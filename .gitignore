# ─────────────────────────────────────────────────────────────
# Legion .gitignore
# The repo ships the *framework* (agents, skills, protocols, CLI).
# Anything an individual operator generates while using Legion —
# memory, logs, client data, real project specs — stays local.
# ─────────────────────────────────────────────────────────────

# ── Dependencies & build output ──────────────────────────────
node_modules/
dist/
*.js.map
*.d.ts.map
*.tsbuildinfo
test-results/
coverage/

# ── Secrets & local config ───────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
.claude/settings.local.json

# ── OS / editor noise ────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.bak

# ── Personal files & data dumps ──────────────────────────────
*-CV.md
*.cv.md
*.sql
*.sqlite
*.db
*.csv

# ── Memory: your second brain is yours ───────────────────────
# Folder skeleton + READMEs are tracked; contents are not.
memory/**
!memory/
!memory/*/
!memory/**/README.md
!memory/obsidian-bridge/config.md

# ── Logs ─────────────────────────────────────────────────────
logs/**
!logs/
!logs/*/
!logs/**/README.md

# ── Legion's own scan output (regenerated by `legion scan`) ──
.legion/*
!.legion/manifest.json

# ── Client vault: only the template example is public ────────
clients/.vault/*
!clients/.vault/README.md
!clients/.vault/example-client/

# ── Generated work output (specs, brainstorms, backlogs) ─────
# Only READMEs and the bundled "user-auth" example are tracked.
specs/*/*
!specs/*/README.md
!specs/*/*user-auth*
brainstorm/*/*
!brainstorm/*/README.md
!brainstorm/*/*example*
build/*/*
!build/*/README.md
!build/*/*user-auth*
projects/*
!projects/.templates/
