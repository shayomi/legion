# Copy to .env (gitignored) and fill in. Read by the Claude Code hooks
# in .claude/hooks/ and by the Legion CLI.

# Absolute path to your Obsidian vault. Leave unset to skip Obsidian sync.
OBSIDIAN_VAULT=

# Optional — only needed if you run scripts from outside the Legion folder.
# LEGION_ROOT=/absolute/path/to/legion

# Optional Notion bridge
# NOTION_TOKEN=
# NOTION_DB_ID=
